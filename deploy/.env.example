# ─────────────────────────────────────────────────────────────────────────────
# AGRI QUIZ DAILY EXAM SYSTEM — free-VM runtime environment
# Copy to .env (same folder) and fill the values.  NEVER commit .env.
#   cp deploy/.env.example deploy/.env && nano deploy/.env
# ─────────────────────────────────────────────────────────────────────────────
TZ=Asia/Kolkata

# --- Telegram exam bot (@Arunkatyanquiz_bot) ---------------------------------
EXAM_TG_TOKEN=
CHAT_ID=-1003784795446                # AGRI QUIZ WORLD (main group: all 3 daily tests)
IARI_CHAT=-1003922097468              # IARI BOOK group (booksend / iari extras)
ADMIN_CHAT=                           # your DM chat id (admin alerts)

# --- MongoDB Atlas (AFO bank) -------------------------------------------------
MONGO_URI=

# --- journal push to GitHub (state.json).  Push does NOT cost Actions minutes -
GITHUB_TOKEN=                         # fine-grained PAT: Contents read/write on the repo
GITHUB_REPOSITORY=b9811507-del/live-test

# --- Razorpay payment links ---------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- paid batches: chat id (join link target) + price per batch ---------------
PAID_CHAT_AFO=
PAID_CHAT_PASHU=
PAID_CHAT_CANE=
PAID_PRICE_AFO=₹251
PAID_PRICE_PASHU=₹151
PAID_PRICE_CANE=₹151
PAID_VERIFY=auto

# --- optional ----------------------------------------------------------------
ADMIN_KEY=                            # /admin commands in DMs
PAY_PROVIDER_TOKEN=                   # Telegram Payments provider token (invoice fallback)
RENDER_URL=                           # optional keepwarm ping target (Render paid-bot page)
# Pins / behaviour switches (defaults are the admin-approved ones)
# PAID_SHOWCASE=off                   # off = no paid message in any group
# REVEAL_AFTER_Q=off                  # off = no per-question reveal message (explanation is in the poll)
# CTA_SHOW=off                        # off = no daily-schedule sign-off line
# POLL_MODE=quiz                      # quiz = correct option + explanation inside the poll
